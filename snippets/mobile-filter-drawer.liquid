{%- comment -%}
  Mobile filter drawer for collection pages
  
  @param {object} results - Collection or search results
  @param {array} filters - Available filters
  @param {string} results_url - Base URL for filter form
{%- endcomment -%}

<div class="mobile-filter-drawer" id="MobileFilterDrawer">
  <div class="mobile-filter-drawer__overlay"></div>
  
  <div class="mobile-filter-drawer__content">
    <div class="mobile-filter-drawer__header">
      <h2 class="mobile-filter-drawer__title">FILTER</h2>
      <button type="button" class="mobile-filter-drawer__close" aria-label="Close filter">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    
    <div class="mobile-filter-drawer__body">
      {%- render 'collection-filters-sidebar', 
        results: results, 
        filters: filters,
        results_url: results_url
      -%}
    </div>
  </div>
</div>

<style>
  .mobile-filter-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
  }
  
  .mobile-filter-drawer.active {
    display: block;
  }
  
  .mobile-filter-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease;
  }
  
  .mobile-filter-drawer__content {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 85%;
    max-width: 400px;
    background-color: rgb(var(--color-background));
    animation: slideInLeft 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  
  .mobile-filter-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }
  
  .mobile-filter-drawer__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  
  .mobile-filter-drawer__close {
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: rgb(var(--color-foreground));
  }
  
  .mobile-filter-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }
  
  .mobile-filter-drawer__body .collection-filters-sidebar {
    width: 100%;
    display: block;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  @keyframes slideInLeft {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const drawer = document.getElementById('MobileFilterDrawer');
    const openButton = document.getElementById('MobileFilterButton');
    const closeButton = drawer?.querySelector('.mobile-filter-drawer__close');
    const overlay = drawer?.querySelector('.mobile-filter-drawer__overlay');
    
    if (!drawer || !openButton) return;
    
    function openDrawer() {
      drawer.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    
    function closeDrawer() {
      drawer.classList.remove('active');
      document.body.style.overflow = '';
    }
    
    openButton.addEventListener('click', openDrawer);
    closeButton?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', closeDrawer);
    
    // Close on escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('active')) {
        closeDrawer();
      }
    });
  });
</script>
