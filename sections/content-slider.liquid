{% liquid
  assign slide_count = section.blocks.size
  assign icons_style = section.settings.icons_style

  assign show_arrows = false
  if icons_style != 'none'
    assign show_arrows = true
  endif

  assign section_modifier_class = ''
  if section.settings.arrows_position == 'sides'
    assign section_modifier_class = 'section-content-slider--arrows-on-sides'
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-content-slider
    {{ section_modifier_class }}
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
  "
  data-testid="content-slider-section"
>
  {% capture slides_content %}
    {% for block in section.blocks %}
      <slideshow-slide
        ref="slides[]"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        class="content-slider__slide"
        {{ block.shopify_attributes }}
      >
        <div class="content-slider__slide-inner">
          <div class="content-slider__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500', class: 'content-slider__image'
              }}
            {% else %}
              <div class="content-slider__placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>
          <div class="content-slider__content">
            {% if block.settings.title != blank %}
              <h2 class="content-slider__title {{ section.settings.title_type_preset }}">
                {{ block.settings.title }}
              </h2>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="content-slider__subtitle {{ section.settings.subtitle_type_preset }}">
                {{ block.settings.subtitle }}
              </p>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="content-slider__text rte {{ section.settings.text_type_preset }}">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </div>
        </div>
      </slideshow-slide>
    {% endfor %}
  {% endcapture %}

  {% render 'slideshow',
    class: 'content-slider__slideshow',
    slides: slides_content,
    show_arrows: show_arrows,
    icon_style: icons_style,
    icon_shape: section.settings.icons_shape,
    arrows_position: section.settings.arrows_position,
    auto_hide_controls: false,
    infinite: true,
    initial_slide: 0,
    slide_count: slide_count,
    slide_position: 'center'
  %}
</div>

{% stylesheet %}
  .section-content-slider {
    position: relative;
  }

  .content-slider__slideshow {
    width: 100%;
    position: relative;
  }

  .content-slider__slideshow slideshow-container {
    position: relative;
  }

  .content-slider__slide {
    min-width: 100%;
    display: flex;
    min-height: 500px;

    @media screen and (min-width: 750px) {
      min-height: 600px;
    }
  }

  .content-slider__slide-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .content-slider__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
    flex-shrink: 0;

    @media screen and (min-width: 750px) {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 55%;
      height: 100%;
    }
  }

  .content-slider__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .content-slider__placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .content-slider__placeholder svg {
    width: 100%;
    height: 100%;
    max-height: 500px;
  }

  .content-slider__content {
    padding: var(--padding-xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    justify-content: center;
    background-color: var(--color-background);
    z-index: 1;

    @media screen and (min-width: 750px) {
      padding: var(--padding-2xl) var(--padding-3xl);
      gap: var(--gap-lg);
      margin-left: auto;
      width: 50%;
      min-height: 100%;
    }
  }

  .content-slider__title {
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .content-slider__subtitle {
    margin: 0;
    font-weight: 400;
    opacity: 0.8;
  }

  .content-slider__text {
    margin: 0;
    line-height: 1.6;
  }

  .content-slider__text p {
    margin: 0 0 var(--gap-sm) 0;
  }

  .content-slider__text p:last-child {
    margin-bottom: 0;
  }

  /* Navigation arrows styling */
  .content-slider__slideshow slideshow-arrows {
    position: absolute;
    bottom: var(--padding-xl);
    right: var(--padding-xl);
    display: flex;
    gap: var(--gap-sm);
    z-index: 10;
    left: auto;
    transform: none;
    pointer-events: auto;

    @media screen and (min-width: 750px) {
      bottom: var(--padding-2xl);
      right: var(--padding-2xl);
    }
  }

  .content-slider__slideshow slideshow-arrows .slideshow-control {
    pointer-events: auto;
  }

  .section-content-slider--arrows-on-sides slideshow-arrows {
    width: 100%;
    justify-content: space-between;
    padding-inline: var(--padding-xl);
    bottom: 50%;
    right: 0;
    transform: translateY(50%);

    @media screen and (min-width: 750px) {
      padding-inline: var(--padding-2xl);
    }
  }
{% endstylesheet %}

