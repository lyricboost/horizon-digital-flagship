{{ 'collection-page.css' | asset_url | stylesheet_tag }}

{%- comment -%} Mobile Filter Drawer {%- endcomment -%}
{%- render 'mobile-filter-drawer',
  results: collection,
  filters: collection.filters,
  results_url: collection.url
-%}

<div class="collection-page-wrapper">
  {%- liquid
    assign sort_by = collection.sort_by | default: collection.default_sort_by
    assign filters = collection.filters
  -%}
  
  {%- comment -%} Filter Sidebar - Desktop Only {%- endcomment -%}
  <aside class="collection-filters-sidebar">
    {%- render 'collection-filters-sidebar', 
      results: collection, 
      filters: filters,
      results_url: collection.url
    -%}
  </aside>
  
  {%- comment -%} Main Content {%- endcomment -%}
  <div class="collection-products">
    {%- comment -%} Collection Header {%- endcomment -%}
    <div class="collection-header">
      <div class="collection-header__info">
        <h1 class="collection-header__title">{{ collection.title }}</h1>
        <p class="collection-header__count">{{ collection.products_count }} Products</p>
      </div>
      
      <div class="collection-header__actions">
        {%- comment -%} Mobile Filter Button {%- endcomment -%}
        <button type="button" class="mobile-filter-button" id="MobileFilterButton">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 4H14M4 8H12M6 12H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Filter
        </button>
        
        {%- comment -%} Sort Dropdown {%- endcomment -%}
        {%- render 'collection-sort-dropdown', 
          results: collection,
          sort_by: sort_by
        -%}
      </div>
    </div>
    
    {%- comment -%} Product Grid {%- endcomment -%}
    {%- paginate collection.products by 24 -%}
      <div class="collection-products-grid">
        {%- for product in collection.products -%}
          <div class="collection-product-card">
            {%- comment -%} Product Card - Using existing theme structure {%- endcomment -%}
            <a href="{{ product.url }}" class="collection-product-card__link">
              <div class="collection-product-card__image-wrapper">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                            {{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    loading="lazy"
                    class="collection-product-card__image"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'collection-product-card__placeholder' }}
                {%- endif -%}
              </div>
              
              <div class="collection-product-card__info">
                <h3 class="collection-product-card__title">
                  {{ product.title }}
                </h3>
                
                <div class="collection-product-card__rating">
                  {%- if product.metafields.reviews.rating.value -%}
                    <span class="collection-product-card__stars">
                      {%- assign rating = product.metafields.reviews.rating.value.rating -%}
                      {%- assign rating_count = product.metafields.reviews.rating.value.count -%}
                      ★★★★★
                    </span>
                    <span class="collection-product-card__rating-count">({{ rating_count }})</span>
                  {%- endif -%}
                </div>
                
                <div class="collection-product-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="collection-product-card__price--sale">
                      {{ product.price | money }}
                    </span>
                    <span class="collection-product-card__price--compare">
                      {{ product.compare_at_price | money }}
                    </span>
                  {%- else -%}
                    <span class="collection-product-card__price--regular">
                      {{ product.price | money }}
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </a>
            
            {%- comment -%} Color Swatches {%- endcomment -%}
            {%- render 'product-card-swatches', product: product, max_swatches: 4 -%}
          </div>
        {%- endfor -%}
      </div>
      
      {%- if paginate.pages > 1 -%}
        <div class="collection-pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<style>
  .collection-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem 1.5rem;
  }
  
  @media screen and (min-width: 750px) {
    .collection-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media screen and (min-width: 990px) {
    .collection-products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  @media screen and (max-width: 749px) {
    .collection-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }
  }
  
  .collection-product-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .collection-product-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .collection-product-card__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.04);
    border-radius: 2px;
  }
  
  .collection-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .collection-product-card:hover .collection-product-card__image {
    transform: scale(1.05);
  }
  
  .collection-product-card__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.1;
  }
  
  .collection-product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  
  .collection-product-card__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  
  .collection-product-card__rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
  }
  
  .collection-product-card__stars {
    color: #ffa500;
  }
  
  .collection-product-card__rating-count {
    color: rgba(var(--color-foreground), 0.5);
  }
  
  .collection-product-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  
  .collection-product-card__price--sale {
    color: rgb(var(--color-sale, 220, 53, 69));
  }
  
  .collection-product-card__price--compare {
    color: rgba(var(--color-foreground), 0.5);
    text-decoration: line-through;
    font-size: 0.875rem;
    font-weight: 400;
  }
  
  .collection-pagination {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }
</style>
