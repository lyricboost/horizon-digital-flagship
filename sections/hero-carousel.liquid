{{ 'section-hero-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-carousel.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign autoplay = section.settings.autoplay
  if autoplay
    assign autoplay_speed = section.settings.autoplay_speed
  endif

  assign text_position = section.settings.text_position | default: 'bottom-left'
  assign overlay_opacity = section.settings.overlay_opacity | default: 15
  assign height_desktop = section.settings.height_desktop | default: 600
  assign height_mobile = section.settings.height_mobile | default: 70
  assign mobile_image_position = section.settings.mobile_image_position | default: 'center'
-%}

<div
  class="hero-carousel section-{{ section.id }}"
  style="--hero-height-desktop: {{ height_desktop }}px; --hero-height-mobile: {{ height_mobile }}vh; --overlay-opacity: {{ overlay_opacity | times: 0.01 }};"
>
  <h2 class="visually-hidden">{{ 'accessibility.slideshow' | t }}</h2>
  
  <hero-carousel-component
    class="hero-carousel__slideshow hero-carousel__slideshow--{{ text_position }}"
    {% if autoplay %}
      autoplay="{{ autoplay_speed }}"
      aria-live="polite"
    {% endif %}
    initial-slide="0"
    infinite
  >
    <div class="hero-carousel__scroller" ref="scroller">
      <div class="hero-carousel__slides" ref="slideshowContainer">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign image_mobile = block.settings.image_mobile
            assign heading = block.settings.heading
            assign subheading = block.settings.subheading
            assign button_label = block.settings.button_label
            assign button_link = block.settings.button_link
            assign text_color = block.settings.text_color | default: '#ffffff'
            assign image_alt = block.settings.image_alt | default: heading
            
            # Use eager loading and high priority only for first slide (LCP)
            assign loading = 'lazy'
            assign fetchpriority = 'auto'
            if forloop.first
              assign loading = 'eager'
              assign fetchpriority = 'high'
            endif
          -%}
          
          <div
            class="hero-carousel__slide"
            ref="slide"
            slide-id="{{ block.id }}"
            {{ block.shopify_attributes }}
            {%- if image != blank -%}
              {%- liquid
                assign mobile_img = image_mobile | default: image
                assign mobile_url = mobile_img | image_url: width: 1200
                assign desktop_url = image | image_url: width: 2000
              -%}
              style="--mobile-bg-image: url('{{ mobile_url }}'); --desktop-bg-image: url('{{ desktop_url }}'); --mobile-bg-position: {{ mobile_image_position }};"
            {%- endif -%}
          >
            <div class="hero-carousel__media">
              {%- if image != blank -%}
                {%- comment -%} Desktop: Use img tag for better SEO/accessibility {%- endcomment -%}
                <img
                  src="{{ image | image_url: width: 1600 }}"
                  srcset="{{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2000 }} 2000w"
                  alt="{{ image_alt | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  loading="{{ loading }}"
                  fetchpriority="{{ fetchpriority }}"
                  class="hero-carousel__image hero-carousel__image--desktop"
                >
                {%- comment -%} Mobile: Background image div for better fill {%- endcomment -%}
                <div class="hero-carousel__image hero-carousel__image--mobile" role="img" aria-label="{{ image_alt | escape }}"></div>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-carousel__placeholder' }}
              {%- endif -%}
              
              <div class="hero-carousel__overlay" aria-hidden="true"></div>
            </div>
            
            <div class="hero-carousel__content-wrapper">
              <div class="hero-carousel__content" style="--text-color: {{ text_color }};">
                {%- if heading != blank -%}
                  <h2 class="hero-carousel__heading h1">
                    {{ heading | escape }}
                  </h2>
                {%- endif -%}
                
                {%- if subheading != blank -%}
                  <p class="hero-carousel__subheading">
                    {{ subheading | escape }}
                  </p>
                {%- endif -%}
                
                {%- if button_label != blank and button_link != blank -%}
                  <div class="hero-carousel__button-wrapper">
                    <a href="{{ button_link }}" class="hero-carousel__button button">
                      {{ button_label | escape }}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    
    {%- if section.blocks.size > 1 -%}
      <div class="hero-carousel__controls">
        {%- comment -%} Pagination dots {%- endcomment -%}
        <div class="hero-carousel__dots" ref="dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="hero-carousel__dot"
              ref="dot"
              aria-label="{{ 'accessibility.go_to_slide' | t: slide_number: forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
              data-slide-index="{{ forloop.index0 }}"
            >
              <span class="visually-hidden">{{ 'accessibility.slide' | t: current: forloop.index, total: section.blocks.size }}</span>
            </button>
          {%- endfor -%}
        </div>
        
        {%- comment -%} Arrow controls {%- endcomment -%}
        <div class="hero-carousel__arrows">
          <button
            type="button"
            class="hero-carousel__arrow hero-carousel__arrow--prev"
            ref="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="hero-carousel__arrow hero-carousel__arrow--next"
            ref="next"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
      
      {%- comment -%} Accessibility: Announce slide changes {%- endcomment -%}
      <div class="visually-hidden" aria-live="polite" aria-atomic="true" ref="announcer"></div>
    {%- endif -%}
  </hero-carousel-component>
</div>

{% schema %}
{
  "name": "Hero Carousel",
  "tag": "section",
  "class": "section-hero-carousel",
  "settings": [
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height (px)",
      "min": 400,
      "max": 800,
      "step": 10,
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height (vh)",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 70
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "info": "Controls how the image is positioned on mobile devices"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (optional crop)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Describe the image for accessibility"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Grace Defined"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Timeless luxury, effortlessly worn"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
