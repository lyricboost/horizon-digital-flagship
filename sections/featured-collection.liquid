{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign view_more_text = section.settings.view_more_text
  assign view_more_link = section.settings.view_more_link
  assign products_to_show = section.settings.products_to_show
  assign show_view_more = section.settings.show_view_more
  assign products_per_view = section.settings.products_per_view
  
  if collection == blank
    assign collection = collections.all
  endif
-%}

<div class="featured-collection section-{{ section.id }}">
  <div class="featured-collection__container page-width">
    <div class="featured-collection__header">
      {%- if heading != blank -%}
        <h2 class="featured-collection__heading h2">{{ heading }}</h2>
      {%- endif -%}
      
      {%- if show_view_more and view_more_link != blank -%}
        <a href="{{ view_more_link }}" class="featured-collection__view-more button button--tertiary">
          {{ view_more_text | default: 'View more' }}
        </a>
      {%- endif -%}
    </div>
    
    {%- if collection.products.size > 0 -%}
      <div class="featured-collection__carousel">
        <div class="featured-collection__track" data-products-per-view="{{ products_per_view }}">
          {%- for product in collection.products limit: products_to_show -%}
            <div class="featured-collection__card">
              <a href="{{ product.url }}" class="featured-collection__card-link">
                <div class="featured-collection__image-wrapper">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      srcset="{{ product.featured_image | image_url: width: 200 }} 200w,
                              {{ product.featured_image | image_url: width: 400 }} 400w,
                              {{ product.featured_image | image_url: width: 600 }} 600w"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                      loading="lazy"
                      class="featured-collection__image"
                    >
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'featured-collection__placeholder' }}
                  {%- endif -%}
                </div>
                
                <div class="featured-collection__info">
                  <h3 class="featured-collection__product-title">
                    {{ product.title }}
                  </h3>
                  
                  <div class="featured-collection__price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="featured-collection__price--sale">
                        {{ product.price | money }}
                      </span>
                      <span class="featured-collection__price--compare">
                        {{ product.compare_at_price | money }}
                      </span>
                    {%- else -%}
                      <span class="featured-collection__price--regular">
                        {{ product.price | money }}
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
        
        {%- if collection.products.size > products_per_view -%}
          <div class="featured-collection__controls">
            <button
              type="button"
              class="featured-collection__arrow featured-collection__arrow--prev"
              aria-label="{{ 'accessibility.previous' | t }}"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            
            <div class="featured-collection__pagination">
              <span class="featured-collection__pagination-current">1</span>
              <span class="featured-collection__pagination-separator">/</span>
              <span class="featured-collection__pagination-total">{{ collection.products.size | divided_by: products_per_view | ceil }}</span>
            </div>
            
            <button
              type="button"
              class="featured-collection__arrow featured-collection__arrow--next"
              aria-label="{{ 'accessibility.next' | t }}"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="featured-collection__empty">
        <p>{{ 'sections.collection_list.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  // Simple carousel navigation
  document.addEventListener('DOMContentLoaded', function() {
    const carousels = document.querySelectorAll('.featured-collection__carousel');
    
    carousels.forEach(carousel => {
      const track = carousel.querySelector('.featured-collection__track');
      const prevButton = carousel.querySelector('.featured-collection__arrow--prev');
      const nextButton = carousel.querySelector('.featured-collection__arrow--next');
      const paginationCurrent = carousel.querySelector('.featured-collection__pagination-current');
      
      if (!track || !prevButton || !nextButton) return;
      
      const productsPerView = parseInt(track.dataset.productsPerView) || 4;
      const cards = track.querySelectorAll('.featured-collection__card');
      const totalPages = Math.ceil(cards.length / productsPerView);
      let currentPage = 0;
      
      function updateCarousel() {
        const scrollAmount = currentPage * track.offsetWidth;
        track.style.transform = `translateX(-${scrollAmount}px)`;
        
        if (paginationCurrent) {
          paginationCurrent.textContent = currentPage + 1;
        }
        
        // Update button states
        prevButton.disabled = currentPage === 0;
        nextButton.disabled = currentPage >= totalPages - 1;
      }
      
      prevButton.addEventListener('click', () => {
        if (currentPage > 0) {
          currentPage--;
          updateCarousel();
        }
      });
      
      nextButton.addEventListener('click', () => {
        if (currentPage < totalPages - 1) {
          currentPage++;
          updateCarousel();
        }
      });
      
      // Initialize
      updateCarousel();
    });
  });
</script>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Weekly Trends"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "products_per_view",
      "label": "Products per view (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Number of products visible at once on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_view_more",
      "label": "Show 'View more' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "'View more' text",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "'View more' link",
      "info": "Links to collection page or custom URL"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
